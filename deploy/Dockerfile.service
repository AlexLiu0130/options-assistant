FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY public ./public
COPY src ./src

RUN npm run build

FROM node:24-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:24-alpine

ENV NODE_ENV=production \
    API_HOST=0.0.0.0 \
    API_PORT=8787 \
    PAPER_TRADE_STORE_PATH=/data/paper-trades.json \
    SERVE_STATIC=true

WORKDIR /app

COPY package.json package-lock.json ./
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY server ./server
COPY src ./src

RUN mkdir -p /data /app/.cache/qveris

EXPOSE 8787

CMD ["node", "--experimental-strip-types", "server/qverisServer.mjs"]
