QVERIS_API_KEY=replace_with_your_qveris_api_key
QVERIS_BASE_URL=https://qveris.ai/api/v1
QVERIS_SESSION_ID=options-assistant-internal
QVERIS_QUOTE_REFRESH_MS=5000
QVERIS_MARKET_REFRESH_MS=15000
QVERIS_OPTIONS_REFRESH_MS=30000
QVERIS_PREWARM_ENABLED=true
QVERIS_PREWARM_INTERVAL_MS=15000
QVERIS_PREWARM_SYMBOLS=TSLA,NVDA,AAPL,SPY,QQQ,IWM,MSFT,AMZN,META,AMD,NFLX,MU,SNDK,PLTR,MSTR,COIN
QVERIS_CLOSED_CACHE_MS=21600000

DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QVERIS_AUTH_BASE_URL=https://qveris.ai
QVERIS_OAUTH_CLIENT_ID=options-assistant
QVERIS_OAUTH_CLIENT_SECRET=replace_with_registered_client_secret
QVERIS_OAUTH_SESSION_SECRET=replace_with_at_least_32_random_bytes
QVERIS_OAUTH_REDIRECT_URI=https://options.example.com/auth/callback
QVERIS_OAUTH_RESOURCE=https://qveris.ai/account
QVERIS_OAUTH_SCOPES=openid profile email
QVERIS_OAUTH_SECURE_COOKIE=true

# The current QVeris RDS endpoint rejects TLS. Use the deployment-specific host and password.
DATABASE_URL=postgresql://options:password@db.example.com:5432/quaestio?sslmode=disable
DATABASE_SCHEMA=options_assistant
OPTIONS_ASSISTANT_ADMIN_EMAILS=admin@example.com

API_HOST=0.0.0.0
API_PORT=8787
CORS_ORIGIN=
PAPER_TRADE_STORE_PATH=/data/paper-trades.json
SERVE_STATIC=true
WEB_HTTP_PORT=80
