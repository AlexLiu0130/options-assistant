{
  "name": "options-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/qverisServer.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "calc:strategies": "node scripts/calculateStrategies.mjs",
    "check:engines": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/engineSelfCheck.ts",
    "check:paper": "node scripts/paperTradeRuntimeSmoke.mjs",
    "python:deps": "python3 -m pip install -r requirements.txt",
    "ibkr:options": "python3 scripts/fetchIbkrOptions.py",
    "smoke:live": "node scripts/liveSmoke.mjs",
    "smoke:qveris": "node server/qverisServer.mjs --smoke"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "ag-grid-community": "^36.0.0",
    "ag-grid-react": "^36.0.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
