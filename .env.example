QVERIS_API_KEY=replace_with_your_qveris_api_key
QVERIS_BASE_URL=https://qveris.ai/api/v1
QVERIS_SESSION_ID=options-assistant-local
QVERIS_QUOTE_REFRESH_MS=5000
QVERIS_MARKET_REFRESH_MS=15000
QVERIS_OPTIONS_REFRESH_MS=10000
QVERIS_CLOSED_CACHE_MS=21600000
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
QVERIS_AUTH_BASE_URL=http://localhost:3000
QVERIS_OAUTH_CLIENT_ID=options-assistant-local
QVERIS_OAUTH_CLIENT_SECRET=replace_with_registered_client_secret
QVERIS_OAUTH_SESSION_SECRET=replace_with_at_least_32_random_bytes
QVERIS_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/auth/callback
QVERIS_OAUTH_RESOURCE=http://localhost:3000/account
QVERIS_OAUTH_SCOPES=openid profile email
QVERIS_OAUTH_SECURE_COOKIE=false
DATABASE_URL=postgresql://options:password@localhost:5432/options_assistant
DATABASE_SCHEMA=options_assistant_dev
# Comma-separated OAuth emails allowed to open #/admin. Leave empty for no admin access.
OPTIONS_ASSISTANT_ADMIN_EMAILS=admin@example.com
API_PORT=8787
