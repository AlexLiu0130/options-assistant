{
  "name": "options-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/qverisServer.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check": "npm run lint && npm run build && npm run check:engines && npm run check:paper && npm run check:assistant",
    "preview": "vite preview",
    "check:engines": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/engineSelfCheck.ts",
    "check:paper": "node scripts/paperTradeRuntimeSmoke.mjs",
    "check:db": "node --experimental-strip-types scripts/paperTradePostgresSmoke.mjs",
    "check:events": "node scripts/productEventsRuntimeSmoke.mjs",
    "report:events": "node scripts/productAnalyticsReport.mjs",
    "check:auth": "node scripts/authRuntimeSmoke.mjs",
    "check:assistant": "node scripts/assistantHarnessSelfCheck.mjs",
    "db:migrate": "node scripts/dbMigrate.mjs",
    "python:deps": "python3 -m pip install -r requirements.txt",
    "ibkr:options": "python3 scripts/fetchIbkrOptions.py",
    "smoke:live": "node scripts/liveSmoke.mjs",
    "smoke:qveris": "node server/qverisServer.mjs --smoke"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "pg": "^8.16.3",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
